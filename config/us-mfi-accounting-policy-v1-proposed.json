{
  "policy_id": "us_mfi_accounting_policy_v1_proposed",
  "version": 1,
  "market": "US",
  "prepared_date": "2026-11-21",
  "status": "proposed_owner_approval_required",
  "purpose": "Versioned shadow-policy specification for deterministic US Magic Formula Investing review. This file is not an approved accounting policy.",
  "production_controls": {
    "production_write": false,
    "production_fundamentals_changed": false,
    "rankings_changed": false,
    "production_approved": false,
    "shadow_only": true
  },
  "universe": {
    "cohort_size": 30,
    "minimum_market_cap_usd_millions": 50,
    "provider": "EdgarTools",
    "unsupported_provider": "visible_excluded_no_fallback",
    "status": "proposed"
  },
  "filings": {
    "forms": [
      "10-K",
      "20-F",
      "40-F"
    ],
    "period": "latest_annual_only",
    "interim_substitution": false,
    "period_alignment_required": true,
    "status": "proposed"
  },
  "ebit": {
    "concept": "consolidated_GAAP_operating_income",
    "non_gaap_substitution": false,
    "pretax_fallback": false,
    "exceptional_item_adjustments": "none_until_cohort_wide_policy_approved",
    "filing_specific_reconstructions": "manual_review_only_not_resolver_input",
    "status": "proposed"
  },
  "invested_capital": {
    "formula": "current_assets_minus_current_liabilities_plus_net_ppe",
    "rou_assets_added_alone": false,
    "lease_liability_symmetry_required_if_rou_included": true,
    "negative_denominator": "withhold_ROC_and_ranking",
    "near_zero_denominator": "manual_review_withhold_ROC_until_materiality_rule_approved",
    "issuer_specific_formula_switching": false,
    "status": "proposed"
  },
  "enterprise_value": {
    "formula": "market_cap_plus_conventional_gross_debt_minus_unrestricted_cash",
    "debt": "current_plus_noncurrent_borrowing_instrument_carrying_values_no_double_count",
    "undrawn_facilities": false,
    "leases": "separate_not_in_baseline_EV",
    "royalty_financing": "separate_pending_owner_policy",
    "failed_sale_leaseback": "separate_pending_owner_policy",
    "contingent_consideration": "separate_pending_owner_policy",
    "noncontrolling_interest": "separate_pending_perimeter_policy",
    "status": "proposed"
  },
  "cash": {
    "deduct_only": "unrestricted_cash_and_cash_equivalents",
    "restricted_cash": false,
    "customer_funds": false,
    "escrow_and_in_transit": false,
    "marketable_securities": "separate_not_cash_like_until_uniform_test_approved",
    "notes_receivable": false,
    "missing_value": "unknown_not_zero",
    "status": "proposed"
  },
  "ranking": {
    "method": "classic_mfi_ordinal_rank_sum_v1",
    "metric_ties": "average_occupied_ordinal_positions",
    "combined_score_ties": "competition_rank",
    "minimum_approved_eligible_cohort": 5,
    "below_minimum": "withhold_final_ranking",
    "status": "proposed"
  },
  "market_data": {
    "price_snapshot": "single_documented_quote_date",
    "filing_alignment": "latest_available_annual_filing_per_issuer",
    "staleness_window": "owner_decision_required",
    "status": "proposed"
  },
  "approval_gates": [
    "exceptional_EBIT_policy",
    "filing_specific_EBIT_bridges",
    "invested_capital_and_near_zero_threshold",
    "lease_and_ROU_symmetry",
    "other_financing_obligations",
    "NCI_perimeter",
    "marketable_securities_cash_like_test",
    "price_staleness_window",
    "legacy_reconciliation_or_explicit_replacement_approval",
    "production_monitoring_and_rollback"
  ],
  "non_goals": [
    "No production writes",
    "No production ranking changes",
    "No issuer-specific policy overrides",
    "No fallback provider",
    "No treating missing values as zero"
  ]
}
