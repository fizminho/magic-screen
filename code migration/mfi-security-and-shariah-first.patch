diff --git a/worker/security.mjs b/worker/security.mjs
new file mode 100644
index 0000000..6df7d4d
--- /dev/null
+++ b/worker/security.mjs
@@ -0,0 +1,79 @@
+// Shared security helpers for the Worker. Plain ESM so Node's test runner can exercise it directly.
+
+const encoder = new TextEncoder();
+
+// Constant-time string comparison. Hashing-free: compare over the longer length and fold the
+// length difference into the result so neither content nor length short-circuits.
+export function timingSafeEqual(a, b) {
+  const x = encoder.encode(String(a ?? ""));
+  const y = encoder.encode(String(b ?? ""));
+  const len = Math.max(x.length, y.length);
+  let diff = x.length ^ y.length;
+  for (let i = 0; i < len; i++) diff |= (x[i] ?? 0) ^ (y[i] ?? 0);
+  return diff === 0;
+}
+
+// Returns null when authorised, otherwise a { status, error } describing the failure.
+// 503 = token not configured (fail closed), 401 = missing/incorrect bearer token.
+export function checkBearer(request, expectedToken) {
+  if (!expectedToken) return { status: 503, error: "UNIVERSE_SYNC_TOKEN is not configured" };
+  const header = request.headers.get("Authorization") ?? "";
+  const match = /^Bearer (.+)$/.exec(header);
+  if (!match || !timingSafeEqual(match[1], expectedToken)) return { status: 401, error: "Unauthorized" };
+  return null;
+}
+
+export function isBearerAuthorized(request, expectedToken) {
+  return checkBearer(request, expectedToken) === null;
+}
+
+// Public refresh endpoints (MFI sync, quote refresh) are rate-limited server-side instead of
+// being locked behind a token, because the UI calls them anonymously. Authorised callers bypass.
+export function cooldownElapsed(lastIso, cooldownMs, now = Date.now()) {
+  if (!lastIso) return true;
+  const last = Date.parse(lastIso);
+  if (Number.isNaN(last)) return true;
+  const age = now - last;
+  return age < 0 || age >= cooldownMs;
+}
+
+export const MFI_FORCE_COOLDOWN_MS = 15 * 60 * 1000;
+export const QUOTE_REFRESH_COOLDOWN_MS = 5 * 60 * 1000;
+
+// Content-Security-Policy matched to index.html: same-origin bundle, Google Fonts only.
+export const CSP = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
+  "font-src 'self' https://fonts.gstatic.com",
+  "img-src 'self' data:",
+  "connect-src 'self'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+].join("; ");
+
+export const SECURITY_HEADERS = {
+  "Content-Security-Policy": CSP,
+  "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
+  "X-Content-Type-Options": "nosniff",
+  "X-Frame-Options": "DENY",
+  "Referrer-Policy": "no-referrer",
+  "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
+  "Cross-Origin-Opener-Policy": "same-origin",
+  "Cross-Origin-Resource-Policy": "same-origin",
+};
+
+export function withSecurityHeaders(response) {
+  // Responses from the assets binding can have immutable headers, so always rebuild.
+  const out = new Response(response.body, response);
+  for (const [name, value] of Object.entries(SECURITY_HEADERS)) out.headers.set(name, value);
+  return out;
+}
+
+// Public endpoints must not echo internal exception text (SQL, upstream URLs, config hints).
+export function publicErrorMessage(error, fallback = "Request failed") {
+  console.error(fallback, error instanceof Error ? error.stack ?? error.message : String(error));
+  return fallback;
+}
diff --git a/worker/security.test.mjs b/worker/security.test.mjs
new file mode 100644
index 0000000..2c843e7
--- /dev/null
+++ b/worker/security.test.mjs
@@ -0,0 +1,93 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { timingSafeEqual, checkBearer, isBearerAuthorized, cooldownElapsed, withSecurityHeaders, SECURITY_HEADERS, CSP, publicErrorMessage } from "./security.mjs";
+
+const req = (auth) => new Request("https://x.test/api", { headers: auth === undefined ? {} : { Authorization: auth } });
+
+test("timingSafeEqual matches only identical strings", () => {
+  assert.equal(timingSafeEqual("abc", "abc"), true);
+  assert.equal(timingSafeEqual("abc", "abd"), false);
+  assert.equal(timingSafeEqual("abc", "abcd"), false);
+  assert.equal(timingSafeEqual("", "a"), false);
+  assert.equal(timingSafeEqual(undefined, undefined), true);
+});
+
+test("checkBearer fails closed when token is not configured", () => {
+  assert.deepEqual(checkBearer(req("Bearer x"), undefined), { status: 503, error: "UNIVERSE_SYNC_TOKEN is not configured" });
+  assert.equal(checkBearer(req("Bearer "), "").status, 503);
+});
+
+test("checkBearer rejects missing, malformed and wrong tokens", () => {
+  for (const h of [undefined, "", "Bearer", "Bearer ", "Basic secret", "bearer secret", "Bearer wrong", "Bearer secret2"]) {
+    assert.equal(checkBearer(req(h), "secret")?.status, 401, String(h));
+  }
+});
+
+test("checkBearer accepts the exact bearer token", () => {
+  assert.equal(checkBearer(req("Bearer secret"), "secret"), null);
+  assert.equal(isBearerAuthorized(req("Bearer secret"), "secret"), true);
+  assert.equal(isBearerAuthorized(req("Bearer nope"), "secret"), false);
+});
+
+test("cooldownElapsed gates repeat refreshes", () => {
+  const now = Date.parse("2026-11-24T12:00:00Z");
+  assert.equal(cooldownElapsed(null, 60000, now), true);
+  assert.equal(cooldownElapsed("garbage", 60000, now), true);
+  assert.equal(cooldownElapsed("2026-11-24T11:59:30Z", 60000, now), false);
+  assert.equal(cooldownElapsed("2026-11-24T11:58:00Z", 60000, now), true);
+  assert.equal(cooldownElapsed("2026-11-24T12:05:00Z", 60000, now), true); // clock skew
+});
+
+test("withSecurityHeaders adds headers, keeps status/body and works on immutable responses", async () => {
+  const res = withSecurityHeaders(Response.redirect("https://x.test/", 302));
+  assert.equal(res.status, 302);
+  for (const k of Object.keys(SECURITY_HEADERS)) assert.ok(res.headers.get(k), k);
+  const ok = withSecurityHeaders(new Response("hi", { status: 200 }));
+  assert.equal(await ok.text(), "hi");
+});
+
+test("CSP blocks framing, plugins and foreign scripts", () => {
+  assert.match(CSP, /frame-ancestors 'none'/);
+  assert.match(CSP, /object-src 'none'/);
+  assert.match(CSP, /script-src 'self'(;|$)/);
+  assert.doesNotMatch(CSP, /unsafe-eval/);
+});
+
+test("publicErrorMessage hides internals", () => {
+  const orig = console.error; console.error = () => {};
+  try { assert.equal(publicErrorMessage(new Error("D1_ERROR: no such table secrets"), "Cached read failed"), "Cached read failed"); }
+  finally { console.error = orig; }
+});
+
+// ---- Route access regression guard (reads the Worker source) ----
+import { readFileSync } from "node:fs";
+const src = readFileSync(new URL("./index.ts", import.meta.url), "utf8");
+const routeBlock = (needle) => {
+  const start = src.indexOf(needle);
+  assert.ok(start > 0, `route not found: ${needle}`);
+  return src.slice(start, start + 700);
+};
+
+test("no hand-rolled bearer comparison remains (must use constant-time checkBearer)", () => {
+  assert.doesNotMatch(src, /!==\s*"Bearer "\s*\+\s*env\./);
+});
+
+test("sensitive routes require the bearer token", () => {
+  for (const route of [
+    'url.pathname==="/api/fundamentals/sync"',
+    'url.pathname==="/api/fundamentals/edgartools/ingest"',
+    'url.pathname==="/api/admin/cleanup-sec-universe"',
+    'url.pathname==="/api/universe/import-my"',
+    'url.pathname==="/api/universe/us/stocks"',
+  ]) assert.match(routeBlock(route), /checkBearer\(request,env\.UNIVERSE_SYNC_TOKEN\)/, route);
+});
+
+test("responses are wrapped with security headers and no wildcard CORS", () => {
+  assert.match(src, /withSecurityHeaders\(await handleRequest\(request, env\)\)/);
+  assert.doesNotMatch(src, /access-control-allow-origin/i);
+});
+
+test("anonymous refresh paths are rate-limited", () => {
+  assert.match(src, /cooldownElapsed\(meta\?\.source_updated_at, MFI_FORCE_COOLDOWN_MS\)/);
+  assert.match(src, /cooldownElapsed\(lastRefresh\?\.t, QUOTE_REFRESH_COOLDOWN_MS\)/);
+});
diff --git a/worker/shariah-screening.mjs b/worker/shariah-screening.mjs
new file mode 100644
index 0000000..4d993e0
--- /dev/null
+++ b/worker/shariah-screening.mjs
@@ -0,0 +1,167 @@
+// Offline, personal-use Shariah-first screening logic (masterplan gates B, C, D).
+// Pure functions only: no network, no database, no production wiring. All inputs are
+// records the owner entered manually after lawfully viewing each source.
+
+export const SHARIAH_SOURCES = Object.freeze(["musaffa", "halalscreener"]);
+export const DEFAULT_MAX_AGE_DAYS = 30; // owner-adjustable freshness window
+
+const STATUS_MAP = new Map([
+  ["halal", "halal"],
+  ["doubtful", "doubtful"],
+  ["not halal", "not_halal"],
+  ["not_halal", "not_halal"],
+  ["non-halal", "not_halal"],
+  ["haram", "not_halal"],
+  ["no data", "no_data"],
+  ["no_data", "no_data"],
+]);
+
+// Unknown wording is never promoted to Halal.
+export function normalizeStatus(raw) {
+  const key = String(raw ?? "").trim().toLowerCase().replace(/\s+/g, " ");
+  return STATUS_MAP.get(key) ?? "unrecognised";
+}
+
+export function normalizeSymbol(raw) {
+  return String(raw ?? "").trim().toUpperCase();
+}
+
+function ageDays(checkedAt, now) {
+  const t = Date.parse(checkedAt);
+  if (Number.isNaN(t)) return null;
+  return (now - t) / 86400000;
+}
+
+// One source's check -> { status, fresh, reason }
+export function assessSourceCheck(check, now, maxAgeDays) {
+  if (!check) return { status: "unchecked", fresh: false, reason: "not checked" };
+  const status = normalizeStatus(check.status);
+  const age = ageDays(check.checked_at, now);
+  if (age === null) return { status, fresh: false, reason: "missing or invalid checked date" };
+  if (age < 0) return { status, fresh: false, reason: "checked date is in the future" };
+  if (age > maxAgeDays) return { status, fresh: false, reason: `stale (${Math.floor(age)} days old)` };
+  return { status, fresh: true, reason: null };
+}
+
+// Decision: "pass" | "review" | "excluded". Never invents a combined ruling.
+export function evaluateShariah(symbol, checks = {}, { now = Date.now(), maxAgeDays = DEFAULT_MAX_AGE_DAYS } = {}) {
+  const per = {};
+  for (const src of SHARIAH_SOURCES) per[src] = assessSourceCheck(checks[src], now, maxAgeDays);
+  const reasons = [];
+  const statuses = SHARIAH_SOURCES.map((s) => per[s].status);
+  const concrete = statuses.filter((s) => ["halal", "doubtful", "not_halal"].includes(s));
+  const conflict = concrete.length > 1 && new Set(concrete).size > 1;
+
+  for (const src of SHARIAH_SOURCES) {
+    const p = per[src];
+    if (p.status === "unchecked") reasons.push(`${src}: not checked`);
+    else if (p.status === "unrecognised") reasons.push(`${src}: unrecognised status "${checks[src]?.status}"`);
+    else if (p.status !== "halal") reasons.push(`${src}: ${p.status}`);
+    if (p.reason && p.status !== "unchecked") reasons.push(`${src}: ${p.reason}`);
+  }
+
+  let decision;
+  if (conflict) { decision = "review"; reasons.unshift("sources disagree — manual review required"); }
+  else if (SHARIAH_SOURCES.every((s) => per[s].status === "halal" && per[s].fresh)) decision = "pass";
+  else decision = "excluded";
+  return { symbol: normalizeSymbol(symbol), decision, per_source: per, reasons };
+}
+
+// Gate C: validate one manual Investing Paths observation. Only fields actually seen are kept.
+export function validateInvestingPathsObservation(obs) {
+  const errors = [];
+  const symbol = normalizeSymbol(obs?.symbol);
+  if (!symbol) errors.push("symbol is required");
+  if (obs?.collection_method !== "manual") errors.push('collection_method must be "manual" (no scraping/automation/AI collection)');
+  if (obs?.manually_verified !== true) errors.push("manually_verified must be true");
+  if (Number.isNaN(Date.parse(obs?.checked_at))) errors.push("checked_at must be a valid date");
+  if (!obs?.source_reference) errors.push("source_reference (direct page reference) is required");
+  const found = obs?.found !== false;
+  const out = { symbol, found, checked_at: obs?.checked_at ?? null, source_reference: obs?.source_reference ?? null };
+  if (!found) {
+    // "Not Found / Not Checked" — never infer a rank or call it unranked.
+    for (const k of ["rank", "earnings_yield", "return_on_capital", "fiscal_year", "fiscal_period"]) {
+      if (obs?.[k] != null) errors.push(`${k} must be empty when found is false`);
+    }
+    return { ok: errors.length === 0, errors, observation: { ...out, status: "not_found" } };
+  }
+  const num = (k, { int = false, min = -Infinity } = {}) => {
+    if (obs?.[k] == null || obs[k] === "") return null;
+    const v = Number(obs[k]);
+    if (!Number.isFinite(v) || (int && !Number.isInteger(v)) || v < min) { errors.push(`${k} is not a valid number`); return null; }
+    return v;
+  };
+  const observation = {
+    ...out, status: "verified",
+    rank: num("rank", { int: true, min: 1 }),
+    earnings_yield: num("earnings_yield"),
+    return_on_capital: num("return_on_capital"),
+    fiscal_year: num("fiscal_year", { int: true, min: 1990 }),
+    fiscal_period: obs?.fiscal_period ? String(obs.fiscal_period) : null,
+  };
+  const anyField = ["rank", "earnings_yield", "return_on_capital", "fiscal_year", "fiscal_period"].some((k) => observation[k] != null);
+  if (!anyField) errors.push("a found ticker must record at least one visible field");
+  return { ok: errors.length === 0, errors, observation };
+}
+
+// Gate D data: one audited row per MFI ticker.
+export function buildShortlist({ universe, shariahChecks = [], ipObservations = [], now = Date.now(), maxAgeDays = DEFAULT_MAX_AGE_DAYS }) {
+  const checksBySymbol = new Map();
+  for (const row of shariahChecks) {
+    const s = normalizeSymbol(row.symbol);
+    checksBySymbol.set(s, { ...(checksBySymbol.get(s) ?? {}), [String(row.source).toLowerCase()]: row });
+  }
+  const ipBySymbol = new Map();
+  const ipErrors = [];
+  for (const raw of ipObservations) {
+    const v = validateInvestingPathsObservation(raw);
+    if (!v.ok) { ipErrors.push({ symbol: v.observation.symbol, errors: v.errors }); continue; }
+    ipBySymbol.set(v.observation.symbol, v.observation);
+  }
+  const seen = new Set();
+  const rows = [];
+  for (const t of universe.tickers ?? []) {
+    const symbol = normalizeSymbol(typeof t === "string" ? t : t.symbol);
+    if (!symbol || seen.has(symbol)) continue;
+    seen.add(symbol);
+    const shariah = evaluateShariah(symbol, checksBySymbol.get(symbol), { now, maxAgeDays });
+    const ip = ipBySymbol.get(symbol) ?? null;
+    let state;
+    if (shariah.decision === "pass") state = ip?.status === "verified" ? "eligible_validated" : "eligible_unvalidated";
+    else state = shariah.decision === "review" ? "needs_review" : "excluded";
+    rows.push({ symbol, name: typeof t === "string" ? null : t.name ?? null, state, shariah, investing_paths: ip ?? { status: "not_checked" } });
+  }
+  const count = (s) => rows.filter((r) => r.state === s).length;
+  return {
+    generated_at: new Date(now).toISOString(),
+    universe: { source_url: universe.source_url ?? null, retrieved_at: universe.retrieved_at ?? null, snapshot: universe.snapshot ?? null, count: rows.length },
+    max_age_days: maxAgeDays,
+    summary: { eligible_validated: count("eligible_validated"), eligible_unvalidated: count("eligible_unvalidated"), needs_review: count("needs_review"), excluded: count("excluded") },
+    ignored_invalid_investing_paths_records: ipErrors,
+    rows,
+  };
+}
+
+const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
+const LABEL = { eligible_validated: "Eligible · validated", eligible_unvalidated: "Eligible · not yet validated", needs_review: "Needs manual review", excluded: "Excluded" };
+
+export function renderReportHtml(result) {
+  const cell = (p) => `${esc(p.status)}${p.fresh ? "" : ` <small>(${esc(p.reason)})</small>`}`;
+  const body = result.rows.map((r) => {
+    const ip = r.investing_paths;
+    const ipText = ip.status === "verified"
+      ? `Rank ${esc(ip.rank ?? "—")} · EY ${esc(ip.earnings_yield ?? "—")} · ROC ${esc(ip.return_on_capital ?? "—")} · ${esc([ip.fiscal_year, ip.fiscal_period].filter(Boolean).join(" ") || "—")}<br><small>checked ${esc(ip.checked_at)} · ${esc(ip.source_reference)}</small>`
+      : ip.status === "not_found" ? `Not found <small>(checked ${esc(ip.checked_at)})</small>` : "Not checked";
+    return `<tr class="${esc(r.state)}"><td><b>${esc(r.symbol)}</b><br><small>${esc(r.name ?? "")}</small></td><td>${esc(LABEL[r.state])}</td><td>${cell(r.shariah.per_source.musaffa)}</td><td>${cell(r.shariah.per_source.halalscreener)}</td><td>${ipText}</td><td><small>${esc(r.shariah.reasons.join("; "))}</small></td></tr>`;
+  }).join("\n");
+  const s = result.summary;
+  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Shariah-first MFI shortlist (personal use)</title>
+<style>:root{--bg:#fff;--fg:#14213d;--mut:#667;--line:#d8dde6;--ok:#e7f6ec;--rev:#fff4d6}@media(prefers-color-scheme:dark){:root{--bg:#0b1020;--fg:#e6ebf5;--mut:#9aa6bd;--line:#26314d;--ok:#12301f;--rev:#3a3112}}
+body{margin:0;padding:16px;background:var(--bg);color:var(--fg);font:14px system-ui,sans-serif}.wrap{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{border-bottom:1px solid var(--line);padding:8px;text-align:left;vertical-align:top}small{color:var(--mut)}tr.eligible_validated{background:var(--ok)}tr.needs_review{background:var(--rev)}tr.excluded{opacity:.75}</style></head><body>
+<h1>Shariah-first MFI shortlist</h1>
+<p><small>Personal-use research record. Not a public feed. Universe: ${esc(result.universe.source_url ?? "unknown")} · retrieved ${esc(result.universe.retrieved_at ?? "unknown")} · ${result.universe.count} tickers · Shariah freshness window ${result.max_age_days} days · generated ${esc(result.generated_at)}</small></p>
+<p>Eligible &amp; validated: <b>${s.eligible_validated}</b> · Eligible, not yet validated: <b>${s.eligible_unvalidated}</b> · Needs review: <b>${s.needs_review}</b> · Excluded: <b>${s.excluded}</b></p>
+<div class="wrap"><table><thead><tr><th>Ticker</th><th>State</th><th>Musaffa</th><th>HalalScreener</th><th>Investing Paths (manual)</th><th>Why</th></tr></thead><tbody>
+${body}
+</tbody></table></div></body></html>`;
+}
diff --git a/worker/shariah-screening.test.mjs b/worker/shariah-screening.test.mjs
new file mode 100644
index 0000000..7233096
--- /dev/null
+++ b/worker/shariah-screening.test.mjs
@@ -0,0 +1,80 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { normalizeStatus, evaluateShariah, validateInvestingPathsObservation, buildShortlist, renderReportHtml } from "./shariah-screening.mjs";
+
+const NOW = Date.parse("2026-11-24T00:00:00Z");
+const chk = (status, checked_at = "2026-11-20") => ({ status, checked_at });
+const ev = (checks, opts = {}) => evaluateShariah("x", checks, { now: NOW, ...opts });
+
+test("status mapping never promotes unknown wording to Halal", () => {
+  assert.equal(normalizeStatus(" HALAL "), "halal");
+  assert.equal(normalizeStatus("Not Halal"), "not_halal");
+  assert.equal(normalizeStatus("No Data"), "no_data");
+  for (const v of ["compliant", "", null, "halal?", "mostly halal"]) assert.equal(normalizeStatus(v), "unrecognised");
+});
+
+test("only two fresh Halal results pass", () => {
+  assert.equal(ev({ musaffa: chk("Halal"), halalscreener: chk("Halal") }).decision, "pass");
+});
+
+test("doubtful, not halal, no data and unchecked are excluded", () => {
+  for (const s of ["Doubtful", "Not Halal", "No Data"]) assert.equal(ev({ musaffa: chk("Halal"), halalscreener: chk(s) }).decision, s === "No Data" ? "excluded" : "review");
+  assert.equal(ev({ musaffa: chk("Doubtful"), halalscreener: chk("Doubtful") }).decision, "excluded");
+  assert.equal(ev({ musaffa: chk("Halal") }).decision, "excluded"); // missing source is not Halal
+  assert.equal(ev({}).decision, "excluded");
+});
+
+test("disagreement between sources goes to manual review, not auto-pass", () => {
+  const r = ev({ musaffa: chk("Halal"), halalscreener: chk("Not Halal") });
+  assert.equal(r.decision, "review");
+  assert.match(r.reasons[0], /disagree/);
+});
+
+test("stale, invalid and future dates do not pass", () => {
+  assert.equal(ev({ musaffa: chk("Halal", "2026-09-01"), halalscreener: chk("Halal") }).decision, "excluded");
+  assert.equal(ev({ musaffa: chk("Halal", "nope"), halalscreener: chk("Halal") }).decision, "excluded");
+  assert.equal(ev({ musaffa: chk("Halal", "2027-01-01"), halalscreener: chk("Halal") }).decision, "excluded");
+  assert.equal(ev({ musaffa: chk("Halal", "2026-10-30"), halalscreener: chk("Halal") }, { maxAgeDays: 60 }).decision, "pass");
+});
+
+const ip = (o = {}) => ({ symbol: "EXA", collection_method: "manual", manually_verified: true, found: true, rank: 5, earnings_yield: 10, return_on_capital: 20, fiscal_year: 2025, checked_at: "2026-11-21", source_reference: "page", ...o });
+
+test("Investing Paths: valid manual observation keeps only visible fields", () => {
+  const v = validateInvestingPathsObservation(ip({ earnings_yield: undefined }));
+  assert.equal(v.ok, true);
+  assert.equal(v.observation.earnings_yield, null);
+  assert.equal(v.observation.rank, 5);
+});
+
+test("Investing Paths: rejects automated, unverified, undated or unreferenced records", () => {
+  for (const bad of [{ collection_method: "scraper" }, { collection_method: "ai" }, { manually_verified: false }, { checked_at: "x" }, { source_reference: "" }, { rank: 0 }, { rank: 1.5 }, { rank: undefined, earnings_yield: undefined, return_on_capital: undefined, fiscal_year: undefined }]) {
+    assert.equal(validateInvestingPathsObservation(ip(bad)).ok, false, JSON.stringify(bad));
+  }
+});
+
+test("Investing Paths: not found records cannot carry an inferred rank", () => {
+  assert.equal(validateInvestingPathsObservation(ip({ found: false, rank: undefined, earnings_yield: undefined, return_on_capital: undefined, fiscal_year: undefined })).observation.status, "not_found");
+  assert.equal(validateInvestingPathsObservation(ip({ found: false })).ok, false);
+});
+
+test("buildShortlist assigns audited states and de-duplicates the universe", () => {
+  const universe = { source_url: "u", retrieved_at: "2026-11-24", tickers: ["A", "a", { symbol: "B" }, "C", "D"] };
+  const s = (symbol, source, status) => ({ symbol, source, status, checked_at: "2026-11-20" });
+  const r = buildShortlist({
+    universe, now: NOW,
+    shariahChecks: [s("A", "musaffa", "Halal"), s("A", "halalscreener", "Halal"), s("B", "musaffa", "Halal"), s("B", "halalscreener", "Halal"), s("C", "musaffa", "Halal"), s("C", "halalscreener", "Doubtful")],
+    ipObservations: [ip({ symbol: "A" }), ip({ symbol: "B", collection_method: "scraper" })],
+  });
+  const by = Object.fromEntries(r.rows.map((x) => [x.symbol, x.state]));
+  assert.deepEqual(by, { A: "eligible_validated", B: "eligible_unvalidated", C: "needs_review", D: "excluded" });
+  assert.equal(r.universe.count, 4);
+  assert.equal(r.ignored_invalid_investing_paths_records.length, 1);
+  assert.deepEqual(r.summary, { eligible_validated: 1, eligible_unvalidated: 1, needs_review: 1, excluded: 1 });
+});
+
+test("report escapes HTML and states personal-use provenance", () => {
+  const r = buildShortlist({ universe: { tickers: [{ symbol: "X", name: "<img src=x onerror=1>" }] }, now: NOW });
+  const html = renderReportHtml(r);
+  assert.doesNotMatch(html, /<img src=x/);
+  assert.match(html, /Personal-use research record/);
+});
