+
+testCase("universe changes clear published ranks; no-op operations keep them", async () => {
+  const db = createDb();
+  await applyMfiSelection(db, [mfi("AAA"), mfi("BBB")], T1);
+  seedRank(db, "AAA", 1); seedRank(db, "BBB", 2);
